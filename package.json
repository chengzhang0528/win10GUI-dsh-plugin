  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./cordis.patch.yml": "./cordis.patch.yml", "./package.json": "./package.json" },
  "files": ["lib/", "cordis.patch.yml", "README.md", "LICENSE"],
  "scripts": { "test": "node --test test/*.test.mjs" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/chengzhang0528/win10GUI-dsh-plugin.git" },
  "homepage": "https://github.com/chengzhang0528/win10GUI-dsh-plugin#readme",
  "bugs": { "url": "https://github.com/chengzhang0528/win10GUI-dsh-plugin/issues" },
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "desktop-automation",
